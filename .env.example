# Copy to .env (or .env.local) and fill in your TV.
# TV IP: Settings → General → Network → IP Status on the TV.
TV_HOST=192.168.1.XX
TV_PORT=8091
# The homebrew service PIN (the dev build ships with 000000).
TV_PIN=000000
# Optional: local Tizen SDK signing. When unset, the package ships unsigned
# and the homebrew service re-signs it with your certificate at install time.
TIZENJS=/path/to/tizenjs
# Optional: enables the AI-written daily brief in the letter.
TV_ANTHROPIC_API_KEY=

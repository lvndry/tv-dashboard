# Copy to .env (or .env.local, which wins over .env) and fill in your TV.
# TV IP: Settings → General → Network → Network Status on the TV.
TV_HOST=192.168.1.XX
# The Tizen Tap service on the TV.
TV_PORT=8091
# The 6-digit PIN shown on the Tizen Tap screen. Developer builds of Tizen Tap use 000000.
TV_PIN=000000
# Optional: sign the package locally with tizenjs and the certificates in ~/.tizen-certs.
# Left unset, a checkout of tizen-tap next to this repo is used when it has one
# (../tizen-tap/node_modules/.bin/tizenjs); otherwise the package ships unsigned
# and Tizen Tap signs it with the TV's own certificate at install time.
# TIZENJS=../tizen-tap/node_modules/.bin/tizenjs

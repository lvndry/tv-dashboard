{
  "name": "tv-dashboard",
  "version": "1.1.0",
  "private": true,
  "description": "A calm, remote-first home screen for Samsung Tizen TVs: the weather and the news written as a short letter, an app rack, and an optional ChatGPT news brief.",
  "scripts": {
    "postinstall": "node tools/ensure-config.js",
    "build": "node tools/build.js",
    "dev": "node tools/dev.js",
    "typecheck": "tsc --noEmit",
    "pkg": "node tools/mkpkg.js",
    "deploy": "node tools/mkpkg.js && node tools/install.js",
    "screenshots": "node tools/screenshots.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "license": "MIT",
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
